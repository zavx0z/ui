{
  "name": "@ui/storybook",
  "version": "0.0.1",
  "description": "Private UI catalog, package routes, lifecycle and static WebGPU Storybook application. Built for MetaFor.",
  "type": "module",
  "private": true,
  "scripts": {
    "storybook": "bun app/server.ts",
    "build": "bun build.ts",
