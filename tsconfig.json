{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "dom.iterable"
    ],
    "types": [
      "@webgpu/types",
      "bun"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@zavx0z/template",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@zavx0z/react": ["../../../renderer/packages/react/src/index.ts"],
      "@zavx0z/template": ["../../../template/index.ts"],
      "@zavx0z/template/*": ["../../../template/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    ".agents/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
