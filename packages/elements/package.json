{
  "name": "@ui/elements",
  "version": "0.0.1",
  "description": "HTML-like retained WebGPU UI elements. Built for MetaFor and reusable in immersive interfaces.",
  "type": "module",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./primitives": "./elements.ts",
    "./button": "./button.ts",
    "./div": "./div.ts",
    "./span": "./span.ts",
    "./text": "./text.ts",
    "./code": "./code.ts",
    "./text-selection": "./text-selection.ts",
    "./img": "./img.ts",
    "./input": "./input.ts",
    "./select": "./select.ts",
    "./popover": "./popover.ts",
    "./list": "./list.ts",
    "./scrollbar": "./scrollbar.ts",
    "./style": "./style.ts",
    "./shape": "./shape.ts",
    "./theme": "./theme.ts",
    "./theme-reference": "./theme-reference.ts",
    "./icons": "./icons.ts",
    "./icon": "./icon.ts",
    "./control": "./control.ts",
    "./grouped-cell": "./grouped-cell.ts",
    "./widget-emboss": "./widget-emboss.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:storybook": "tsc --noEmit --pretty false --project storybook/tsconfig.json"
  },
  "dependencies": {
    "@engine/core": "link:@engine/core",
    "@layout/core": "link:@layout/core",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/ui.git",
    "directory": "packages/elements"
  },
  "homepage": "https://zavx0z.github.io/ui/elements/",
  "metafor": "https://github.com/zavx0z/metafor",
  "license": "MIT",
  "keywords": ["webgpu", "ui", "elements", "metafor"]
}
