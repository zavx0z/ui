{
  "name": "@ui/workspace",
  "version": "0.1.0",
  "description": "DOM and CSS components with a private WebGPU Storybook. Built for MetaFor and reusable in immersive interfaces.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "check": "bun run typecheck && bun run test && bun run --cwd packages/storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/ui.git"
  },
  "homepage": "https://zavx0z.github.io/ui/",
  "metafor": "https://github.com/zavx0z/metafor",
  "license": "MIT",
  "author": "zavx0z",
  "keywords": [
    "webgpu",
    "ui",
    "immersive",
    "spatial",
    "storybook",
    "metafor"
  ],
  "dependencies": {
    "@ui/components": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^25.5.0",
    "@webgpu/types": "^0.1.68",
    "@ui/storybook": "workspace:*",
    "@zavx0z/storybook": "link:@zavx0z/storybook",
    "typescript": "^7.0.2"
  }
}
