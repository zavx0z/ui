{
  "version": 2,
  "selectors": {
    "ui": {
      "supported": true,
      "package": "@ui/storybook",
      "cwd": "packages/storybook",
      "command": ["bun", "app/server.ts"],
      "host": "127.0.0.1",
      "hostEnv": "UI_STORYBOOK_HOST",
      "port": 4017,
      "portEnv": "UI_STORYBOOK_PORT",
      "origin": "http://127.0.0.1:4017",
      "httpMarker": "<title>UI storybook</title>",
      "ready": {"kind": "dataset", "name": "uiStorybook", "value": "ready"},
      "canvas": {"selector": "canvas", "capability": "none", "touch": false},
      "pages": [
        {"mountPath": "/elements", "canvas": {"selector": "#stage-canvas", "capability": "webgpu", "touch": false}},
        {"mountPath": "/components", "canvas": {"selector": "#stage-canvas", "capability": "webgpu", "touch": false}},
        {"mountPath": "/hud", "canvas": {"selector": "canvas", "capability": "none", "touch": false}},
        {"mountPath": "/", "canvas": {"selector": "canvas", "capability": "none", "touch": false}}
      ],
      "routes": {"default": "/"},
      "stateKey": "ui",
      "logName": "ui.log"
    }
  }
}
